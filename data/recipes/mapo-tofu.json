  "image": "",
  "description": "豆腐與絞肉搭配豆瓣醬燒煮，鹹香帶辣，適合搭配白飯。",
  "servings": "3人份",
  "prepTime": "10分鐘",
  "cookTime": "15分鐘",
  "ingredients": [
    {
      "name": "嫩豆腐",
      "amount": "1盒",
      "note": "切成方塊"
    },
    {
      "name": "豬絞肉",
      "amount": "150克",
      "note": ""
    },
    {
      "name": "蒜頭",
      "amount": "2瓣",
      "note": "切末"
    },
    {
      "name": "薑",
      "amount": "1小塊",
      "note": "切末"
    },
    {
      "name": "辣豆瓣醬",
      "amount": "1大匙",
      "note": "依口味調整"
    },
    {
      "name": "醬油",
      "amount": "1大匙",
      "note": ""
    },
    {
      "name": "水",
      "amount": "200毫升",
      "note": ""
    },
    {
      "name": "太白粉",
      "amount": "1茶匙",
      "note": "加少量水調勻"
    },
    {
      "name": "青蔥",
      "amount": "1根",
      "note": "切蔥花"
    }
  ],
  "steps": [
    "鍋中放少許油，炒香薑末和蒜末。",
    "加入豬絞肉炒散，炒至變色。",
    "加入辣豆瓣醬和醬油拌炒出香氣。",
    "倒入水並加入豆腐，小火煮約5分鐘。",
    "淋入太白粉水輕輕攪拌，煮至醬汁濃稠。",
    "撒上蔥花即可盛盤。"
  ],
  "notes": [
    "豆腐容易破碎，拌煮時可以輕推鍋子，減少直接翻炒。"
  ]
