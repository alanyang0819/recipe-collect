{
  "slug": "san-bei-ji",
  "name": "三杯雞",
  "category": "台式料理",
  "tags": [
    "雞肉",
    "九層塔",
    "下飯"
  ],
  "image": "",
  "description": "以麻油、醬油和米酒調味，加入薑片與九層塔炒煮的經典台菜。",
  "servings": "2人份",
  "prepTime": "15分鐘",
  "cookTime": "25分鐘",
  "ingredients": [
    {
      "name": "雞腿肉",
      "amount": "500克",
      "note": "切塊"
    },
    {
      "name": "薑",
      "amount": "30克",
      "note": "切片"
    },
    {
      "name": "蒜頭",
      "amount": "6瓣",
      "note": "去皮"
    },
    {
      "name": "九層塔",
      "amount": "1把",
      "note": "摘取葉片"
    },
    {
      "name": "麻油",
      "amount": "2大匙",
      "note": ""
    },
    {
      "name": "米酒",
      "amount": "3大匙",
      "note": ""
    },
    {
      "name": "醬油",
      "amount": "3大匙",
      "note": ""
    },
    {
      "name": "冰糖",
      "amount": "1大匙",
      "note": ""
    }
  ],
  "steps": [
    "雞腿肉洗淨並擦乾，切成適口大小。",
    "鍋中加入麻油，以小火煸香薑片和蒜頭。",
    "加入雞肉，煎炒至表面上色。",
    "加入米酒、醬油和冰糖，煮滾後轉小火燜煮約15分鐘。",
    "開蓋收至醬汁濃稠，加入九層塔拌炒至香氣釋出即可。"
  ],
  "notes": [
    "麻油以小火加熱，避免過度加熱產生苦味。"
  ]
}
