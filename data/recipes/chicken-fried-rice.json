{
  "slug": "chicken-fried-rice",
  "name": "雞肉炒飯",
  "category": "中式料理",
  "tags": [
    "雞肉",
    "米飯",
    "快速料理"
  ],
  "image": "",
  "description": "以隔夜飯搭配雞肉、雞蛋和蔬菜快速炒製的簡單主食。",
  "servings": "2人份",
  "prepTime": "10分鐘",
  "cookTime": "10分鐘",
  "ingredients": [
    {
      "name": "白飯",
      "amount": "2碗",
      "note": "冷藏隔夜飯較容易炒散"
    },
    {
      "name": "雞胸肉",
      "amount": "150克",
      "note": "切小丁"
    },
    {
      "name": "雞蛋",
      "amount": "2顆",
      "note": "打散"
    },
    {
      "name": "冷凍蔬菜",
      "amount": "80克",
      "note": "退冰"
    },
    {
      "name": "青蔥",
      "amount": "1根",
      "note": "切蔥花"
    },
    {
      "name": "醬油",
      "amount": "1大匙",
      "note": ""
    },
    {
      "name": "食用油",
      "amount": "適量",
      "note": ""
    },
    {
      "name": "鹽",
      "amount": "少許",
      "note": ""
    }
  ],
  "steps": [
    "雞胸肉切丁，雞蛋打散，白飯先用飯匙撥鬆。",
    "熱鍋加油，倒入蛋液炒至半熟後盛起。",
    "加入雞肉丁炒至熟透，再加入冷凍蔬菜拌炒。",
    "加入白飯炒散，淋上醬油並調整鹹度。",
    "放回雞蛋，加入蔥花拌勻即可。"
  ],
  "notes": [
    "炒飯時可用中大火快速翻炒，避免白飯變得濕黏。"
  ]
}
