{
  "slug": "miso-salmon",
  "name": "味噌鮭魚",
  "category": "日式料理",
  "tags": [
    "魚肉",
    "鮭魚",
    "烤箱料理"
  ],
  "image": "",
  "description": "鮭魚以味噌、味醂和少許糖醃製後烘烤，味道甘鹹濃郁。",
  "servings": "2人份",
  "prepTime": "35分鐘",
  "cookTime": "15分鐘",
  "ingredients": [
    {
      "name": "鮭魚排",
      "amount": "2片",
      "note": "約每片150克"
    },
    {
      "name": "味噌",
      "amount": "2大匙",
      "note": ""
    },
    {
      "name": "味醂",
      "amount": "1大匙",
      "note": ""
    },
    {
      "name": "米酒",
      "amount": "1大匙",
      "note": ""
    },
    {
      "name": "糖",
      "amount": "1茶匙",
      "note": ""
    },
    {
      "name": "食用油",
      "amount": "少許",
      "note": "塗烤盤用"
    }
  ],
  "steps": [
    "將味噌、味醂、米酒和糖攪拌均勻。",
    "鮭魚擦乾，均勻抹上味噌醬，冷藏醃約30分鐘。",
    "烤箱預熱至200°C，烤盤薄薄塗油或鋪烘焙紙。",
    "將鮭魚放入烤箱烤約12至15分鐘，至魚肉熟透。",
    "取出稍微放涼後即可食用。"
  ],
  "notes": [
    "烘烤時間會依魚排厚度和烤箱狀況不同而變化。"
  ]
}
