{
  "slug": "gong-bao-ji-ding",
  "name": "宮保雞丁",
  "category": "中式料理",
  "tags": [
    "雞肉",
    "下飯",
    "辣"
  ],
  "image": "images/gong-bao-ji-ding.png",
  "description": "雞肉搭配花生與宮保醬汁炒製，鹹香微辣。",
  "servings": "2人份",
  "prepTime": "15分鐘",
  "cookTime": "10分鐘",
  "ingredients": [
    {
      "name": "雞胸肉",
      "amount": "250克",
      "note": "切丁"
    },
    {
      "name": "花生",
      "amount": "40克",
      "note": "熟花生"
    },
    {
      "name": "乾辣椒",
      "amount": "6根",
      "note": "可依喜好調整"
    },
    {
      "name": "青蔥",
      "amount": "2根",
      "note": "切段"
    },
    {
      "name": "蒜頭",
      "amount": "2瓣",
      "note": "切末"
    },
    {
      "name": "醬油",
      "amount": "1大匙",
      "note": ""
    },
    {
      "name": "米酒",
      "amount": "1大匙",
      "note": ""
    },
    {
      "name": "烏醋",
      "amount": "1大匙",
      "note": ""
    },
    {
      "name": "糖",
      "amount": "1茶匙",
      "note": ""
    }
  ],
  "steps": [
    "雞肉加入少許醬油與米酒抓醃約10分鐘。",
    "將醬油、米酒、烏醋與糖混合成調味醬汁。",
    "熱鍋加油，放入雞丁炒至表面變色後盛起。",
    "用原鍋炒香蒜末與乾辣椒，放回雞丁並加入醬汁拌炒至熟。",
    "加入花生與蔥段快速拌炒即可盛盤。"
  ],
  "notes": [
    "乾辣椒可依喜好增減；花生最後加入，可保留酥脆口感。"
  ]
}
