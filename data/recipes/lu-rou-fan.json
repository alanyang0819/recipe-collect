{
  "slug": "lu-rou-fan",
  "name": "滷肉飯",
  "category": "台式料理",
  "tags": [
    "豬肉",
    "米飯",
    "滷味"
  ],
  "image": "",
  "description": "將豬肉與紅蔥頭慢慢滷煮，淋在熱飯上，是經典台灣家常料理。",
  "servings": "4人份",
  "prepTime": "15分鐘",
  "cookTime": "60分鐘",
  "ingredients": [
    {
      "name": "豬五花肉",
      "amount": "500克",
      "note": "切小丁"
    },
    {
      "name": "紅蔥頭",
      "amount": "6顆",
      "note": "切片"
    },
    {
      "name": "蒜頭",
      "amount": "3瓣",
      "note": "切末"
    },
    {
      "name": "醬油",
      "amount": "4大匙",
      "note": ""
    },
    {
      "name": "米酒",
      "amount": "2大匙",
      "note": ""
    },
    {
      "name": "冰糖",
      "amount": "1大匙",
      "note": ""
    },
    {
      "name": "五香粉",
      "amount": "1/4茶匙",
      "note": "可省略"
    },
    {
      "name": "水",
      "amount": "500毫升",
      "note": ""
    },
    {
      "name": "白飯",
      "amount": "4碗",
      "note": "盛盤用"
    }
  ],
  "steps": [
    "鍋中放少許油，將紅蔥頭炒至金黃後盛起。",
    "放入豬五花肉丁煸炒至出油並略微上色。",
    "加入蒜末、醬油、米酒、冰糖和五香粉炒勻。",
    "倒入水並加入炒好的紅蔥頭，煮滾後轉小火。",
    "蓋鍋燉煮約45至60分鐘，至肉丁軟嫩、醬汁入味。",
    "將滷肉和醬汁淋在白飯上即可享用。"
  ],
  "notes": [
    "可依喜好加入滷蛋或燙青菜一起搭配。"
  ]
}
