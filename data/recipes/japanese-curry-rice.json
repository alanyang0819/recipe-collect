{
  "slug": "japanese-curry-rice",
  "name": "日式咖哩飯",
  "category": "日式料理",
  "tags": [
    "咖哩",
    "雞肉",
    "米飯"
  ],
  "image": "",
  "description": "雞肉、馬鈴薯和紅蘿蔔燉煮後加入咖哩塊，口味溫和濃郁。",
  "servings": "4人份",
  "prepTime": "15分鐘",
  "cookTime": "35分鐘",
  "ingredients": [
    {
      "name": "雞腿肉",
      "amount": "300克",
      "note": "切塊"
    },
    {
      "name": "馬鈴薯",
      "amount": "2顆",
      "note": "去皮切塊"
    },
    {
      "name": "紅蘿蔔",
      "amount": "1根",
      "note": "切塊"
    },
    {
      "name": "洋蔥",
      "amount": "1顆",
      "note": "切絲"
    },
    {
      "name": "日式咖哩塊",
      "amount": "4小塊",
      "note": "依產品包裝調整"
    },
    {
      "name": "水",
      "amount": "700毫升",
      "note": ""
    },
    {
      "name": "白飯",
      "amount": "4碗",
      "note": "盛盤用"
    },
    {
      "name": "食用油",
      "amount": "1大匙",
      "note": ""
    }
  ],
  "steps": [
    "雞肉切塊，馬鈴薯和紅蘿蔔去皮切塊，洋蔥切絲。",
    "鍋中加入食用油，炒香洋蔥。",
    "加入雞肉炒至表面變色，再放入馬鈴薯和紅蘿蔔拌炒。",
    "倒入水，煮滾後撈除浮沫，轉小火燉煮約20分鐘。",
    "確認食材軟熟後關火，加入咖哩塊並攪拌至融化。",
    "再次以小火煮至醬汁濃稠，淋在白飯上即可。"
  ],
  "notes": [
    "咖哩塊的鹹度和辣度依品牌不同，可先從較少的量開始加入。"
  ]
}
